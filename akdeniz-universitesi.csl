<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="tr-TR">
<info>
<title>Akdeniz Üniversitesi Fen Bilimleri Enstitüsü</title>
<id>http://csl.mendeley.com/styles/styles/akdeniz-universitesi-fen-bilimleri-enstitusu-</id>
<link href="http://www.zotero.org/styles/akdeniz-universitesi-fen-bilimleri-enstitusu" rel="self"/>
<author>
<name>Tez Yazım Kılavuzu 2017</name>
</author>
<category citation-format="author-date"/>
<category field="science"/>
<updated>2026-06-01T14:58:55+00:00</updated>
</info>
<locale xml:lang="tr">
<terms>
<term name="and">ve</term>
<term name="et-al">vd.</term>
<term name="editor" form="short">
<single>Ed.</single>
<multiple>Eds.</multiple>
</term>
<term name="page" form="short">
<single>s.</single>
<multiple>ss.</multiple>
</term>
<term name="accessed">Son erişim tarihi</term>
<term name="in">In:</term>
</terms>
</locale>
<citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
<sort>
<key variable="issued"/>
<key macro="author-short"/>
</sort>
<layout prefix="(" suffix=")" delimiter="; ">
<group delimiter=" ">
<text macro="author-short"/>
<text macro="year-date"/>
</group>
</layout>
</citation>
<bibliography hanging-indent="true" et-al-min="11" et-al-use-first="10" entry-spacing="0" line-spacing="1">
<sort>
<key macro="author"/>
<key variable="issued"/>
<key variable="title"/>
</sort>
<layout suffix=".">
<group delimiter=". ">
<text macro="author"/>
<text macro="year-date"/>
<choose>
<if type="bill book graphic legal_case legislation motion_picture report song" match="any">
<text macro="book"/>
</if>
<else-if type="chapter paper-conference" match="any">
<text macro="chapter"/>
</else-if>
<else-if type="thesis">
<text macro="thesis"/>
</else-if>
<else-if type="webpage post post-weblog" match="any">
<text macro="webpage"/>
</else-if>
<else>
<text macro="article"/>
</else>
</choose>
</group>
</layout>
</bibliography>
<macro name="author-short">
<names variable="author">
<name form="short" and="text" delimiter=", " delimiter-precedes-last="never"/>
<substitute>
<names variable="editor"/>
<names variable="translator"/>
<text variable="title" form="short"/>
</substitute>
</names>
</macro>
<macro name="author">
<names variable="author">
<name name-as-sort-order="all" sort-separator=", " initialize-with="." and="text" delimiter=", " delimiter-precedes-last="never"/>
<substitute>
<names variable="editor">
<name name-as-sort-order="all" sort-separator=", " initialize-with="." and="text" delimiter=", " delimiter-precedes-last="never"/>
<label form="short" prefix=" (" suffix=")"/>
</names>
<text variable="title"/>
</substitute>
</names>
</macro>
<macro name="year-date">
<choose>
<if variable="issued">
<date variable="issued">
<date-part name="year"/>
</date>
</if>
<else>
<text term="no date" form="short"/>
</else>
</choose>
</macro>
<macro name="editor">
<names variable="editor">
<name and="text" delimiter=", " delimiter-precedes-last="never" initialize-with="."/>
<label form="short" prefix=" (" suffix=")"/>
</names>
</macro>
<macro name="article">
<group delimiter=". ">
<text variable="title"/>
<group delimiter=", ">
<text variable="container-title" font-style="italic"/>
<group delimiter=": ">
<group>
<text variable="volume"/>
<text variable="issue" prefix=" (" suffix=")"/>
</group>
<text variable="page"/>
</group>
</group>
<choose>
<if variable="DOI">
<text variable="DOI" prefix="Doi: "/>
</if>
</choose>
</group>
</macro>
<macro name="book">
<group delimiter=". ">
<text variable="title"/>
<group delimiter=", ">
<text variable="publisher"/>
<text variable="publisher-place"/>
<group>
<text variable="number-of-pages"/>
<label variable="number-of-pages" form="short" prefix=" "/>
</group>
</group>
</group>
</macro>
<macro name="chapter">
<group delimiter=". ">
<text variable="title"/>
<group delimiter=": ">
<text term="in" text-case="capitalize-first"/>
<group delimiter=", ">
<text macro="editor"/>
<text variable="container-title"/>
<text variable="publisher"/>
<text variable="publisher-place"/>
<group>
<label variable="page" form="short" suffix=" "/>
<text variable="page"/>
</group>
</group>
</group>
</group>
</macro>
<macro name="thesis">
<group delimiter=". ">
<text variable="title"/>
<group delimiter=", ">
<text variable="genre"/>
<text variable="publisher"/>
<text variable="publisher-place"/>
<group>
<text variable="number-of-pages"/>
<label variable="number-of-pages" form="short" prefix=" "/>
</group>
</group>
</group>
</macro>
<macro name="webpage">
<group delimiter=". ">
<text variable="title"/>
<group delimiter=" ">
<text variable="URL"/>
<group prefix="[" suffix="]">
<text term="accessed" suffix=": "/>
<date variable="accessed">
<date-part name="day" form="numeric-leading-zeros" suffix="."/>
<date-part name="month" form="numeric-leading-zeros" suffix="."/>
<date-part name="year"/>
</date>
</group>
</group>
</group>
</macro>
</style>
